{
  "name": "cinevo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,realtime -c blue,magenta \"next dev -p 3001\" \"tsx watch --env-file=.env realtime-server.ts\"",
    "build": "next build",
    "start": "concurrently -n next,realtime -c blue,magenta \"next start -p 3001\" \"tsx --env-file=.env realtime-server.ts\"",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "make-admin": "tsx --env-file=.env scripts/make-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@privy-io/node": "^0.35.0",
    "@privy-io/react-auth": "^3.48.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "next": "14.2.35",
    "prisma": "6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "uuid": "^14.0.2",
    "viem": "^2.57.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
