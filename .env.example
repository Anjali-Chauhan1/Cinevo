DATABASE_URL="file:./dev.db"
JWT_SECRET="cinevo-demo-dev-secret-change-in-prod-9f8e7d6c5b4a"
INTERNAL_SECRET="cinevo-dev-internal-secret"
REALTIME_PORT=3002
REALTIME_SERVER_URL="http://localhost:3002"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_REALTIME_URL="http://localhost:3002"

# ---------------------------------------------------------------------------
# Onchain mode (Monad testnet). Leave NEXT_PUBLIC_CHAIN_MODE unset to keep the
# demo ledger — the app then needs none of the settings below.
# Setup steps: see "Onchain mode" in README.md.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_CHAIN_MODE="onchain"
# NEXT_PUBLIC_CHAIN_ID=10143
# Optional: a faster/private Monad RPC (defaults to https://testnet-rpc.monad.xyz)
# NEXT_PUBLIC_RPC_URL=""
# ₹ per USD used to show stablecoin amounts in rupees
# NEXT_PUBLIC_USD_INR_RATE=83
# From dashboard.privy.io (enable email + Google login, Monad testnet, and gas sponsorship)
# NEXT_PUBLIC_PRIVY_APP_ID=""
# PRIVY_APP_SECRET=""
# The deployer key: it owns the contracts and acts as the Cinova operator.
# NEVER commit a real key; keep it only in your local .env / hosting secrets.
# OPERATOR_PRIVATE_KEY=""
